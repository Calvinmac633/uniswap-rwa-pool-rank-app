# Everything below is a public endpoint or a public, permissionless contract
# address on Robinhood Chain — none of this is secret. Copy this file to .env
# only if you want to override a default (e.g. swap in a private RPC).

# Public RPC is rate-limited; set this if you have a faster/private endpoint.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
